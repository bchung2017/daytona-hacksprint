# Copy to .env. Uploaded to the parent sandbox only; never to children.
DAYTONA_API_KEY=
ANTHROPIC_API_KEY=
ANCHOR_API_KEY=

# Claims store. Default is a local `surreal` server the parent runs on 127.0.0.1:8001.
# Point at a SurrealDB Cloud instance instead by changing these (wss://<host>/rpc).
SURREAL_URL=ws://127.0.0.1:8001/rpc
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=incentive
SURREAL_DB=agent

# SurrealDB Agent Memory context (provenance + supersession). Optional: leave blank to skip.
# From Studio > Agent Memory > your context > API keys: host (https://...), context id, API key (sp-...).
MEMORY_URL=
MEMORY_CONTEXT=
MEMORY_API_KEY=
# Optional. Blank writes to the key's default region. If set, register the path in Studio > Scopes first.
MEMORY_SCOPE=

ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Shared secret the ElevenLabs server tool sends as X-Tool-Secret.
CPA_TOOL_SECRET=
# Post-call webhook HMAC secret from the ElevenLabs workspace webhook settings. Optional.
ELEVENLABS_WEBHOOK_SECRET=

ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT=incentive-agent

# Parent preview link for port 8000; deploy.py prints it after the first create.
PUBLIC_BASE_URL=

# Model roles. Fallback if Fable 5.1 is unavailable: set PLAN_MODEL=claude-opus-5-5.
PLAN_MODEL=claude-fable-5-1
FETCH_MODEL=claude-opus-5-5

# Relative tolerance for agent_value vs cpa_value (0.01 = 1%).
MATCH_TOLERANCE=0.01
